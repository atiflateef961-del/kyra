# Runtime mode. Use true during development and automated testing so no
# computer-control action can affect this machine.
APP_ENV=development
KYRA_DRY_RUN=true
APP_HOST=0.0.0.0
APP_PORT=8000

# The browser UI may connect only to this local agent URL by default.
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
VITE_AGENT_URL=http://localhost:8000

# Firebase browser configuration. These identifiers are public configuration,
# but should still be kept environment-specific. Do not place Admin credentials
# or private keys in NEXT_PUBLIC_* variables.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=

# Server-only Firebase Admin configuration. Download a service-account key
# from Firebase Console > Project settings > Service accounts, then copy its
# values here. Never commit real values or expose them through VITE_* variables.
MONGODB_URI=mongodb://127.0.0.1:27017/kyra
# FIREBASE_PROJECT_ID=kyra-5b496
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional cloud or local reasoning for unmatched natural-language commands.
# Known gestures and exact voice phrases stay local and never call these providers.
# KYRA_CLOUD_AI=false
# KYRA_LOCAL_AI=false
# KYRA_LOCAL_AI_URL=http://127.0.0.1:11434
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_API_KEY=
